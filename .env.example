# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cms_lasu?retryWrites=true&w=majority

# BetterAuth (HTTP-only cookie sessions)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Dev seed users (BetterAuth-managed; optional). When a trio is unset, that
# seeder is silently skipped.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_TECH_EMAIL=
SEED_TECH_PASSWORD=
SEED_TECH_NAME=

# OpenAI AI Triage
OPENAI_API_KEY=sk-...
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000

# Ably Real-time Push
ABLY_API_KEY=...

# Cloudinary Image Upload
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Upstash Redis (BullMQ + rate limiting)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# SLA Sweep Cron (runs every 5 minutes on Vercel)
CRON_SECRET=change-me-to-a-random-string

# AI Cost Ceiling (NFR-5)
AI_COST_CEILING_USD=5
AI_COST_CEILING_FALLBACK_USD=50

# AI Cost Cap Flip (read at request time by lib/ai/triage.ts). When the daily
# cron sees monthly cost > AI_COST_CEILING_USD it flips this to "true" so AI is
# bypassed and the route goes straight to the rules based fallback.
AI_TRIAGE_FALLBACK_TO_RULES=

# Anonymous Tracker (Feature 5). Optional dedicated secret. When unset, the
# tracker JWT falls back to BETTER_AUTH_SECRET. Prefer a dedicated secret for
# production; the fallback is acceptable for dev only.
ANONYMOUS_TOKEN_SECRET=
